DATABASE_URL=postgres://postgres:postgres@localhost:5432/mqtt_logger
# Plain env var (drizzle-kit needs it too). Everything below is NUXT_* runtimeConfig.
NUXT_MQTT_URL=mqtt://localhost:1883
# NUXT_MQTT_USERNAME=
# NUXT_MQTT_PASSWORD=
# NUXT_MQTT_SHARED_GROUP=mqtt-logger
# NUXT_TIMESCALE_MODE=auto
# NUXT_TIMESCALE_COMPRESS_AFTER=7 days
# NUXT_TIMESCALE_RETENTION=1 year

# Session cookie encryption (nuxt-auth-utils), at least 32 characters.
# Always set it: the GUI reads the session even when auth is disabled.
# (In dev, nuxt-auth-utils generates one into .env if missing.)
NUXT_SESSION_PASSWORD=

# Auth (OIDC). Empty client ID = auth disabled, every route open.
# NUXT_OAUTH_OIDC_CLIENT_ID=mqtt-logger
# NUXT_OAUTH_OIDC_CLIENT_SECRET=
# NUXT_OAUTH_OIDC_OPENID_CONFIG=https://auth.example.com/.well-known/openid-configuration
# Only needed when the callback URL can't be inferred (proxies, tunnels)
# NUXT_OAUTH_OIDC_REDIRECT_URL=
# Required "aud" of bearer tokens. Empty = not checked.
# NUXT_OIDC_AUDIENCE=
